{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "./worker-configuration.d.ts"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "worker/**/*.ts",
    "shared/**/*.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "worker/**/*.test.ts"
  ]
}
